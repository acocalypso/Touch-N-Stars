{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/plugins/*/server"
  ]
}
